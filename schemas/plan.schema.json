{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seangalliher/supervised-worker/schemas/plan.schema.json",
  "title": "Supervised Worker Durable Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "goal", "items", "completion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "enum": ["active", "complete", "inactive"] },
    "goal": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "items": {
      "type": "array",
      "description": "Queue items. Each id must be unique; the helper enforces this semantic constraint because JSON Schema cannot express uniqueness by one object property.",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status"],
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "parked" } },
              "required": ["status"]
            },
            "then": { "required": ["resumeWhen"] }
          }
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "status": { "enum": ["pending", "in_progress", "banked", "parked"] },
          "resumeWhen": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "completion": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enumeration", "evidence"],
          "properties": {
            "enumeration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "source", "checkedAt", "remainingActionable"],
              "properties": {
                "status": { "const": "complete" },
                "source": { "type": "string", "minLength": 1, "pattern": "\\S" },
                "checkedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:(?!0000)\\d{4})-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12]\\d|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
                },
                "remainingActionable": { "const": 0 }
              }
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/evidenceRef" }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "enum": ["active", "inactive"] } },
        "required": ["mode"]
      },
      "then": { "properties": { "completion": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "mode": { "const": "complete" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "completion": { "type": "object" },
          "items": {
            "type": "array",
            "not": {
              "contains": {
                "type": "object",
                "properties": { "status": { "enum": ["pending", "in_progress"] } },
                "required": ["status"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "locator": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}