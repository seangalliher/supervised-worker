{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seangalliher/supervised-worker/schemas/workflow.schema.json",
  "title": "Supervised Worker Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tracker", "wip", "authority", "validation", "review"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scope"],
      "properties": {
        "kind": { "enum": ["github"] },
        "scope": { "type": "string", "minLength": 3, "pattern": "\\S" },
        "query": { "type": "string", "default": "is:issue is:open" }
      }
    },
    "wip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxActive", "maxCoupled"],
      "properties": {
        "maxActive": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxCoupled": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "boundaries"],
      "properties": {
        "mode": { "enum": ["supervised", "delegated"] },
        "boundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonBlank" },
          "uniqueItems": true
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architect", "builder", "reviewer"],
      "properties": {
        "architect": { "$ref": "#/$defs/agentSelector" },
        "builder": { "$ref": "#/$defs/agentSelector" },
        "reviewer": { "$ref": "#/$defs/agentSelector" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focused", "broad"],
      "properties": {
        "focused": { "$ref": "#/$defs/nonBlank" },
        "broad": { "$ref": "#/$defs/nonBlank" },
        "receiptGlobs": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonBlank" },
          "uniqueItems": true
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "independent"],
      "properties": {
        "required": { "const": true },
        "independent": { "const": true },
        "agent": { "$ref": "#/$defs/agentSelector" },
        "requiredModel": { "$ref": "#/$defs/modelId" },
        "requiredModelFamily": { "$ref": "#/$defs/modelFamily" },
        "requireDifferentModelFamily": { "type": "boolean" }
      },
      "dependentRequired": {
        "requiredModel": ["requiredModelFamily"],
        "requiredModelFamily": ["requiredModel"]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "requireDifferentModelFamily": { "const": true }
            },
            "required": ["requireDifferentModelFamily"]
          },
          "then": {
            "required": ["requiredModel", "requiredModelFamily"]
          }
        }
      ]
    },
    "filing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximumNewPerClosures": { "type": "integer", "minimum": 0 },
        "closureDenominator": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._:/-]{0,126}[a-z0-9])?$"
    },
    "modelFamily": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,62}[a-z0-9])?$"
    },
    "agentSelector": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
        },
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 193,
          "pattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]{0,62}[a-z0-9])?:[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
        }
      ],
      "not": {
        "enum": [
          "supervised-worker",
          "seangalliher-supervised-worker",
          "supervised-worker:supervised-worker",
          "supervised-worker:seangalliher-supervised-worker"
        ]
      }
    }
  }
}